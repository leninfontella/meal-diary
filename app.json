{
  "expo": {
    "name": "Diário Alimentar",
    "slug": "diario-alimentar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "diarioalimentar",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para registrar suas refeições.",
          "cameraPermission": "Permita o acesso à câmera para fotografar suas refeições."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
